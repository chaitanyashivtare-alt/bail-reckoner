# NyaySetu — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ── JWT Authentication ────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────────
# For SQLite (default dev):
DATABASE_URL=sqlite:///bail_reckoner.db
# For PostgreSQL (optional prod):
# DATABASE_URL=postgresql://user:password@localhost:5432/bail_reckoner

# ── Document Encryption ──────────────────────────────────────────
# Fernet key — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCUMENT_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# ── File Storage ──────────────────────────────────────────────────
SECURE_VAULT_PATH=./secure_vault
MAX_UPLOAD_SIZE_MB=50

# ── Server ────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
DEBUG=true

# ── RAG brief: choose ONE of three options (all free) ────────────
# 1) NOTHING set  -> the app still builds a cited brief from the retrieved sources with fixed rules (no AI writer, no internet).
# 2) Free hosted model (quickest, works on any laptop). Get a free key at https://aistudio.google.com/apikey (Gemini, no card)
#    or https://console.groq.com/keys (Groq). Text you submit is sent to that service after identifiers are masked.
LLM_API_KEY=
# Gemini (default):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
# Groq instead:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# Model names change over time; if you get "model not found", copy the current name from the provider's site.
# 3) Local model with Ollama (nothing leaves your machine, but needs a download and a capable laptop):
#    ollama pull qwen2.5:7b-instruct   (leave LLM_API_KEY empty)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=300
OLLAMA_NUM_CTX=8192
# AI endpoints use your free-tier quota; limit calls per client IP per hour.
RAG_MAX_CALLS_PER_HOUR=30
# Set to 1 to skip the optional dense (embedding) index even if it has been built.
# RAG_DISABLE_DENSE=1
