# NyaySetu — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ── JWT Authentication ────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────────
# For SQLite (default dev):
DATABASE_URL=sqlite:///bail_reckoner.db
# For PostgreSQL (optional prod):
# DATABASE_URL=postgresql://user:password@localhost:5432/bail_reckoner

# ── Document Encryption ──────────────────────────────────────────
# Fernet key — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCUMENT_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# ── File Storage ──────────────────────────────────────────────────
SECURE_VAULT_PATH=./secure_vault
MAX_UPLOAD_SIZE_MB=50

# ── Server ────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
DEBUG=true

# ── RAG brief (local model via Ollama, free) ─────────────────────
# Without Ollama running the app still works: you get retrieved judgments and rule-based triggers, but no written brief or auto-fill.
# Install Ollama, then run: ollama pull qwen2.5:7b-instruct
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=300
# AI endpoints spend API credit; limit calls per client IP per hour.
RAG_MAX_CALLS_PER_HOUR=30
# Set to 1 to skip the optional dense (embedding) index even if it has been built.
# RAG_DISABLE_DENSE=1
